<?php
/**
 * GoDaddy / cPanel production SMTP (copy to config/smtp.local.php on the live server).
 * Do not commit this file with secrets.
 *
 * Shared hosting blocks outbound SMTP (Gmail, smtpout.secureserver.net:465).
 * The website must send through local port 25. Do not AUTH — local Exim
 * returns 535 if you pass the mailbox password. That password is for
 * Outlook / phone (Connect Devices), not for PHP.
 *
 * Inbox still needs DNS:
 *    SPF:   v=spf1 include:secureserver.net -all
 *    DKIM:  cPanel → Email Deliverability → Enable for eventifywlc.com
 *    DMARC: v=DMARC1; p=none; rua=mailto:noreply@eventifywlc.com
 */

define('EVENTIFY_SMTP_HOST', 'localhost');
define('EVENTIFY_SMTP_PORT', 25);
define('EVENTIFY_SMTP_USERNAME', '');
define('EVENTIFY_SMTP_PASSWORD', '');
define('EVENTIFY_SMTP_FROM_EMAIL', 'noreply@eventifywlc.com');
define('EVENTIFY_SMTP_FROM_NAME', 'EVENTIFY');
define('EVENTIFY_SMTP_NO_AUTH', true);
define('EVENTIFY_SMTP_DISABLE_TLS', true);
define('EVENTIFY_SMTP_EHLO_HOST', 'eventifywlc.com');
define('EVENTIFY_SMTP_FALLBACK_MAIL', false);

// If localhost is refused, use GoDaddy's local relay (same no-auth rules):
// define('EVENTIFY_SMTP_HOST', 'relay-hosting.secureserver.net');
